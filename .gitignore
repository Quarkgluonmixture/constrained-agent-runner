state/
events/
results/
logs/
*.log
token.txt
config.local.json
projects.json

# Local extension configuration carries the token and the private conversation URL.
wake/extension/config.local.json

# Environments and build artifacts
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Test scratch
tests/**/_tmp/

.DS_Store
